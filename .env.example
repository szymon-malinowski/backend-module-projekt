PORT=3000
# Replace with the pooled Neon PostgreSQL connection string for hosted deployment.
DATABASE_URL=postgres://postgres:postgres@EP.example.neon.tech/backend_module?sslmode=require
CLIENT_ORIGIN=http://localhost:3000
# Generate a random secret of at least 32 bytes; never commit the actual value.
JWT_SECRET=
TRUST_PROXY=false
# Use a separate Neon branch/database for tests.
TEST_DATABASE_URL=postgres://postgres:postgres@TEST-EP.example.neon.tech/backend_module_test?sslmode=require
