PORT=3000
# Use the pooled Neon PostgreSQL connection string for hosted deployment.
DATABASE_URL=postgres://USER:PASSWORD@EP.example.neon.tech/DBNAME?sslmode=require
CLIENT_ORIGIN=http://localhost:3000
# Generate a random secret of at least 32 bytes; never commit the actual value.
JWT_SECRET=
# Set true only when the app runs behind a trusted reverse proxy.
TRUST_PROXY=false
# Test database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend_module_test
